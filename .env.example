# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/onemission_hq?schema=public"

# CORS (optional)
CORS_ORIGINS="*"

# Shipping gateway configuration
SHIPPING_PROVIDER="mock"
SHIPPING_SUPPORTED_COURIERS="jne,jnt,sicepat,pos,ninja,anteraja"
RAJAONGKIR_API_KEY=""
RAJAONGKIR_BASE_URL="https://rajaongkir.komerce.id/api/v1/"
RAJAONGKIR_TIMEOUT="15000"

# Biteship shipping execution (Phase 1 fulfillment only; checkout still uses RajaOngkir)
BITESHIP_MODE="sandbox"
BITESHIP_BASE_URL="https://api.biteship.com"
BITESHIP_SANDBOX_API_KEY=""
BITESHIP_PRODUCTION_API_KEY=""
BITESHIP_TIMEOUT_MS="15000"
BITESHIP_WEBHOOK_SECRET=""
BITESHIP_ORIGIN_CONTACT_NAME=""
BITESHIP_ORIGIN_CONTACT_PHONE=""
BITESHIP_ORIGIN_CONTACT_EMAIL=""
BITESHIP_ORIGIN_ORGANIZATION="OneMission"
BITESHIP_ORIGIN_ADDRESS=""
BITESHIP_ORIGIN_POSTAL_CODE=""
BITESHIP_ORIGIN_AREA_ID=""
BITESHIP_ORIGIN_COLLECTION_METHOD="pickup"
# Origin coordinates for pickup bookings (e.g. Lion pickup requires origin_coordinate).
# Keep empty when not configured; both must be set together. Example values below.
BITESHIP_ORIGIN_LATITUDE="-6.2253114"
BITESHIP_ORIGIN_LONGITUDE="106.7993735"
BITESHIP_DEFAULT_ITEM_WEIGHT_GRAMS="200"
BITESHIP_DEFAULT_ITEM_LENGTH_CM="20"
BITESHIP_DEFAULT_ITEM_WIDTH_CM="15"
BITESHIP_DEFAULT_ITEM_HEIGHT_CM="5"
BITESHIP_COURIER_SERVICE_MAP_JSON="{}"
BITESHIP_RATES_COURIERS="anteraja,jne,sicepat"

# Payment gateway configuration
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"
MIDTRANS_TIMEOUT="15000"

# Application URLs
HQ_URL="http://localhost:3000"
COMMERCE_URL="http://localhost:5173"

# Customer authentication configuration
JWT_SECRET="change-this-secret"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="30d"
PASSWORD_RESET_EXPIRES="60m"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email delivery configuration
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_NAME="ONEMISSION"
SMTP_FROM_EMAIL=""

# Upstash Redis (optional)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ImageKit — server-side uploads for the movement CMS (Home).
# The private key must stay server-only and is never exposed to the browser.
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_PUBLIC_KEY=""
IMAGEKIT_URL_ENDPOINT=""
