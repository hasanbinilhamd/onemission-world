enum NewsletterSubscriberStatus {
  ACTIVE
  UNSUBSCRIBED
  BLOCKED
}

enum NewsletterSubscriberSource {
  FOOTER
}

model Faq {
  id          String   @id
  question    String
  answer      String
  category    String   @default("")
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isPublished])
  @@index([sortOrder])
}

model NewsletterSubscriber {
  id             String                     @id
  email          String                     @unique
  status         NewsletterSubscriberStatus @default(ACTIVE)
  subscribedAt   DateTime                   @default(now())
  unsubscribedAt DateTime?
  source         NewsletterSubscriberSource @default(FOOTER)
  ipAddress      String                     @default("")
  userAgent      String                     @default("")
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@index([status])
  @@index([subscribedAt])
  @@index([source])
}

enum LaunchSubscriberStatus {
  SUBSCRIBED
  NOTIFIED
  UNSUBSCRIBED
}

model LaunchSubscriber {
  id               String                 @id
  code             String                 @unique
  phone            String                 @unique
  countryCode      String                 @default("ID")
  source           String                 @default("launch-page")
  status           LaunchSubscriberStatus @default(SUBSCRIBED)
  launchNotifiedAt DateTime?
  notes            String                 @default("")
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  deletedAt        DateTime?

  @@index([status])
  @@index([source])
  @@index([createdAt])
  @@index([deletedAt])
}

enum VerificationType {
  REGISTER
  RESET_PASSWORD
  CHANGE_EMAIL
  LOGIN_OTP
}

model VerificationToken {
  id          String           @id @default(cuid())
  type        VerificationType
  identifier  String
  otpHash     String
  payload     Json?
  expiresAt   DateTime
  attempts    Int              @default(0)
  resendCount Int              @default(0)
  verifiedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([type, identifier])
  @@index([identifier])
  @@index([type])
  @@index([expiresAt])
}

model CheckoutSession {
  id                  String                @id
  checkoutNumber      String                @unique
  status              String                @default("DRAFT")
  customerId          String
  customerCode        String                @default("")
  customerName        String                @default("")
  customerEmail       String                @default("")
  customerPhone       String                @default("")
  salesChannelId      String
  salesChannelCode    String                @default("")
  salesChannelName    String                @default("")
  currency            String                @default("IDR")
  subtotal            Float                 @default(0)
  shippingCost        Float                 @default(0)
  discount            Float                 @default(0)
  tax                 Float                 @default(0)
  grandTotal          Float                 @default(0)
  promotionSnapshot   Json?
  recipientName       String                @default("")
  phone               String                @default("")
  originDistrict      String
  destinationDistrict String
  courier             String
  courierService      String
  shippingProvider    String                @default("rajaongkir")
  shippingOriginId    String                @default("")
  shippingDestinationId String              @default("")
  shippingDescription String                @default("")
  estimatedDelivery   String                @default("")
  provinceId          String
  provinceName        String                @default("")
  cityId              String
  cityName            String                @default("")
  districtId          String
  districtName        String                @default("")
  postalCode          String                @default("")
  streetAddress       String                @default("")
  processingKey       String?
  processingStartedAt DateTime?
  expiresAt           DateTime
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  items               CheckoutSessionItem[]
  paymentAttempts     PaymentAttempt[]
  orders              Order[]

  @@index([customerId])
  @@index([salesChannelId])
  @@index([status])
  @@index([expiresAt])
  @@index([processingKey])
}

model CheckoutSessionItem {
  id           String          @id
  checkoutId   String
  checkout     CheckoutSession @relation(fields: [checkoutId], references: [id], onDelete: Cascade)
  productId    String
  variantId    String
  productName  String
  variantName  String
  productImage String          @default("")
  weight       Float           @default(0)
  sku          String
  qty          Int
  price        Float
  currency     String          @default("IDR")
  subtotal     Float
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([checkoutId])
  @@index([productId])
  @@index([variantId])
}

model PaymentAttempt {
  id                    String          @id
  attemptNumber         String          @unique
  checkoutSessionId     String
  checkoutSession       CheckoutSession @relation(fields: [checkoutSessionId], references: [id], onDelete: Cascade)
  orderId               String?
  order                 Order?          @relation("OrderPaymentAttempts", fields: [orderId], references: [id], onDelete: SetNull)
  provider              String
  providerReference     String          @default("")
  providerTransactionId String          @default("")
  snapToken             String          @default("")
  snapRedirectUrl       String          @default("")
  status                String          @default("CREATED")
  grossAmount           Float
  currency              String          @default("IDR")
  paymentType           String          @default("")
  issuer                String          @default("")
  acquirer              String          @default("")
  fraudStatus           String          @default("")
  transactionTime       DateTime?
  settlementTime        DateTime?
  providerPayload       Json?
  expiresAt             DateTime
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  currentForOrder       Order?          @relation("OrderCurrentPaymentAttempt")

  @@index([checkoutSessionId])
  @@index([orderId])
  @@index([status])
}

model Order {
  id                           String           @id
  orderNumber                  String           @unique
  publicOrderNumber            String           @unique
  checkoutSessionId            String           @unique
  checkoutSession              CheckoutSession  @relation(fields: [checkoutSessionId], references: [id], onDelete: Cascade)
  paymentAttemptId             String?          @unique
  paymentAttempt               PaymentAttempt?  @relation("OrderCurrentPaymentAttempt", fields: [paymentAttemptId], references: [id], onDelete: SetNull)
  paymentAttempts              PaymentAttempt[] @relation("OrderPaymentAttempts")
  paymentReference             String           @default("")
  customerId                   String
  customerCode                 String           @default("")
  customerName                 String           @default("")
  customerEmail                String           @default("")
  customerPhone                String           @default("")
  salesChannelId               String
  salesChannelCode             String           @default("")
  salesChannelName             String           @default("")
  recipientName                String           @default("")
  recipientPhone               String           @default("")
  originDistrict               String           @default("")
  destinationDistrict          String           @default("")
  courier                      String           @default("")
  courierService               String           @default("")
  shippingDescription          String           @default("")
  estimatedDelivery            String           @default("")
  provinceId                   String           @default("")
  provinceName                 String           @default("")
  cityId                       String           @default("")
  cityName                     String           @default("")
  districtId                   String           @default("")
  districtName                 String           @default("")
  postalCode                   String           @default("")
  streetAddress                String           @default("")
  status                       String           @default("READY_FOR_FULFILLMENT")
  fulfillmentStatus            String           @default("PENDING")
  shipmentCourier              String           @default("")
  shipmentService              String           @default("")
  trackingNumber               String           @default("")
  shippingDate                 DateTime?
  actualShippingCost           Float?
  shippingProvider             String           @default("manual")
  shippingOriginId             String           @default("")
  shippingDestinationId        String           @default("")
  shippingProviderOrderId      String           @default("")
  shippingProviderTrackingId   String           @default("")
  shippingProviderStatus       String           @default("")
  shippingProviderStatusAt     DateTime?
  shippingLabelUrl             String           @default("")
  shippingProviderPayload      Json?
  currency                     String           @default("IDR")
  subtotal                     Float            @default(0)
  discount                     Float            @default(0)
  shippingCost                 Float            @default(0)
  tax                          Float            @default(0)
  grandTotal                   Float            @default(0)
  promotionSnapshot            Json?
  orderConfirmationEmailSentAt DateTime?
  customerReceivedAt           DateTime?
  createdAt                    DateTime         @default(now())
  updatedAt                    DateTime         @updatedAt
  items                        OrderItem[]
  productReviews               ProductReview[]
  promotionUsages              PromotionUsage[]
  timelines                    OrderTimeline[]
  returnRequest                ReturnRequest?

  @@index([customerId])
  @@index([salesChannelId])
  @@index([status])
  @@index([fulfillmentStatus])
  @@index([shippingProvider])
  @@index([shippingProviderOrderId])
  @@index([shippingProviderTrackingId])
}

model OrderItem {
  id            String         @id
  orderId       String
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  variantId     String
  sku           String
  productName   String
  variantName   String
  productImage  String         @default("")
  price         Float
  weight        Float          @default(0)
  quantity      Int
  subtotal      Float
  currency      String         @default("IDR")
  productReview ProductReview?
  returnRequestItems ReturnRequestItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model ProductReview {
  id          String    @id
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId String    @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating      Int
  title       String    @default("")
  comment     String
  isPublished Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([productId])
  @@index([orderId])
  @@index([customerId])
  @@index([isPublished])
  @@index([createdAt])
}

model OrderTimeline {
  id        String   @id
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  eventName String
  updatedBy String   @default("")
  notes     String   @default("")
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([createdAt])
}

model ReturnRequest {
  id                        String          @id
  orderId                   String          @unique
  order                     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId                String
  customer                  Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  requestType               String          @default("PRODUCT_RETURN")
  previousOrderStatus       String          @default("")
  previousFulfillmentStatus String          @default("")
  reason                    String
  description               String          @default("")
  status                    String          @default("REQUESTED")
  rejectReason              String          @default("")
  refundStatus              String          @default("NONE")
  refundReference           String          @default("")
  refundAmount              Float           @default(0)
  refundProvider            String          @default("")
  refundProviderId          String          @default("")
  refundFailureReason       String          @default("")
  refundFailureSource       String          @default("")
  retryAvailable            Boolean         @default(false)
  refundMetadata            Json?
  attachments               String[]
  requestedAt               DateTime        @default(now())
  approvedAt                DateTime?
  completedAt               DateTime?
  refundRequestedAt         DateTime?
  refundApprovedAt          DateTime?
  refundProcessingAt        DateTime?
  refundCompletedAt         DateTime?
  lastRefundAttemptAt       DateTime?
  rejectedAt                DateTime?
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
  resolution                String          @default("REFUND")
  receivedAt                DateTime?
  receivedBy                String          @default("")
  inspectedAt               DateTime?
  inspectedBy               String          @default("")
  inspectionResult          String          @default("")
  inspectionNote            String          @default("")
  manualRefundMethod        String          @default("")
  manualRefundDate          DateTime?
  manualRefundReference     String          @default("")
  manualRefundNote          String          @default("")
  manualRefundPaidBy        String          @default("")
  financeTransactionId      String          @default("")
  replacementStatus         String          @default("")
  replacementSentAt         DateTime?
  replacementNote           String          @default("")
  replacementItems          Json?
  refundAttempts            RefundAttempt[]
  items                     ReturnRequestItem[]

  @@index([customerId])
  @@index([requestType])
  @@index([status])
  @@index([refundStatus])
  @@index([resolution])
  @@index([inspectionResult])
  @@index([financeTransactionId])
  @@index([requestedAt])
}

model ReturnRequestItem {
  id              String        @id
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItemId     String
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id])
  quantity        Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([returnRequestId])
  @@index([orderItemId])
}

model ReturnStockAllocation {
  id                  String   @id
  returnRequestId     String
  returnRequestItemId String   @default("")
  productId           String
  variantId           String
  quantity            Int
  allocationType      String
  status              String   @default("ALLOCATED")
  stockMovementId     String   @default("")
  createdBy           String   @default("")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([returnRequestId, returnRequestItemId, allocationType])
  @@index([returnRequestId])
  @@index([returnRequestItemId])
  @@index([variantId])
  @@index([allocationType])
  @@index([stockMovementId])
}

model RefundAttempt {
  id               String        @id
  returnRequestId  String
  returnRequest    ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  attemptNumber    Int
  gatewayName      String        @default("MIDTRANS")
  status           String        @default("PENDING")
  refundKey        String        @default("")
  midtransRefundId String        @default("")
  transactionId    String        @default("")
  httpStatus       Int?
  statusCode       String        @default("")
  statusMessage    String        @default("")
  requestBody      Json?
  responseBody     Json?
  responseAt       DateTime?
  failureSource    String        @default("")
  failureReason    String        @default("")
  failureCode      String        @default("")
  retryAvailable   Boolean       @default(false)
  createdBy        String        @default("")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([returnRequestId, attemptNumber])
  @@index([returnRequestId])
  @@index([status])
  @@index([refundKey])
}
